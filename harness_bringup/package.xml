<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>harness_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration that bring up the simulated wire-harness robot cell.</description>
  <maintainer email="rezahendi590@gmail.com">Reza</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>harness_description</exec_depend>
  <exec_depend>harness_sim</exec_depend>
  <exec_depend>harness_task</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
