<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>harness_learning</name>
  <version>0.1.0</version>
  <description>Gymnasium environment, expert demonstration recording and replay for learning wire routing.</description>
  <maintainer email="rezahendi590@gmail.com">Reza</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>harness_core</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- also needs pip packages (not rosdep keys): mujoco, gymnasium -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
