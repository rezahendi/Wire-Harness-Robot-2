<?xml version="1.0"?>
<!--
  UR5e-class arm + wrist F/T sensor + parallel gripper for the wire-harness cell.

  Kinematics follow the published UR5e DH parameters, joint names and zero pose
  are those of ur_description (so joint values mean the same as on a real UR5e),
  and base_link / base / tool0 have the ur_description meaning. Link frames are
  the DH frames (each joint turns about its link's z axis), exactly as in the
  MuJoCo model generated by harness_core/scene.py.
  Visuals are simple primitives; no meshes are needed.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="harness_cell">

  <!-- ===================== parameters (keep in sync with harness_core/config.py) -->
  <xacro:property name="d1" value="0.1625"/>
  <xacro:property name="a2" value="-0.425"/>
  <xacro:property name="a3" value="-0.3922"/>
  <xacro:property name="d4" value="0.1333"/>
  <xacro:property name="d5" value="0.0997"/>
  <xacro:property name="d6" value="0.0996"/>
  <xacro:property name="ft_thickness" value="0.0375"/>
  <xacro:property name="tcp_offset" value="0.17"/>
  <xacro:property name="house_len" value="0.075"/>
  <xacro:property name="finger_stroke" value="0.03"/>
  <xacro:property name="pad_w" value="0.010"/>
  <xacro:property name="pad_t" value="0.003"/>
  <xacro:property name="pad_h" value="0.012"/>
  <!-- finger geometry derived like in scene.py -->
  <xacro:property name="tcp_g" value="${tcp_offset - ft_thickness}"/>
  <xacro:property name="pad_center_z" value="${tcp_g + 0.006 - pad_h}"/>
  <xacro:property name="finger_len" value="${pad_center_z - house_len}"/>

  <!-- ===================== materials -->
  <material name="ur_light"><color rgba="0.80 0.82 0.84 1"/></material>
  <material name="ur_cap"><color rgba="0.36 0.52 0.68 1"/></material>
  <material name="ur_dark"><color rgba="0.18 0.19 0.21 1"/></material>
  <material name="ft_grey"><color rgba="0.55 0.56 0.58 1"/></material>
  <material name="gripper_black"><color rgba="0.14 0.15 0.17 1"/></material>
  <material name="pad_orange"><color rgba="0.85 0.35 0.20 1"/></material>

  <xacro:macro name="cyl" params="r l xyz rpy:='0 0 0' mat">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><cylinder radius="${r}" length="${l}"/></geometry>
      <material name="${mat}"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="inertial" params="m xyz ixx iyy izz">
    <inertial>
      <origin xyz="${xyz}"/>
      <mass value="${m}"/>
      <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== links -->
  <link name="world"/>

  <link name="base_link">
    <xacro:cyl r="0.076" l="0.086" xyz="0 0 0.043" mat="ur_dark"/>
    <xacro:cyl r="0.078" l="0.008" xyz="0 0 0.088" mat="ur_cap"/>
    <xacro:inertial m="4.0" xyz="0 0 0.04" ixx="0.0044" iyy="0.0044" izz="0.0072"/>
  </link>

  <!-- UR controller base frame (base_link rotated by pi about z), as in ur_description -->
  <link name="base"/>

  <link name="shoulder_link">
    <xacro:cyl r="0.062" l="0.072" xyz="0 0 0.128" mat="ur_light"/>
    <xacro:inertial m="3.761" xyz="0 0 0.12" ixx="0.0103" iyy="0.0103" izz="0.0067"/>
  </link>

  <link name="upper_arm_link">
    <xacro:cyl r="0.062" l="0.21" xyz="0 0 0.07" mat="ur_light"/>
    <xacro:cyl r="0.063" l="0.012" xyz="0 0 -0.036" mat="ur_cap"/>
    <xacro:cyl r="0.046" l="0.365" xyz="-0.2125 0 0.138" rpy="0 ${pi/2} 0" mat="ur_light"/>
    <xacro:cyl r="0.052" l="0.21" xyz="${a2} 0 0.074" mat="ur_light"/>
    <xacro:cyl r="0.053" l="0.012" xyz="${a2} 0 0.179" mat="ur_cap"/>
    <xacro:inertial m="8.058" xyz="-0.2125 0 0.138" ixx="0.0151" iyy="0.1339" izz="0.1339"/>
  </link>

  <link name="forearm_link">
    <xacro:cyl r="0.038" l="0.33" xyz="-0.195 0 0.007" rpy="0 ${pi/2} 0" mat="ur_light"/>
    <xacro:cyl r="0.042" l="0.12" xyz="${a3} 0 0.02" mat="ur_light"/>
    <xacro:inertial m="2.846" xyz="-0.1961 0 0.007" ixx="0.0041" iyy="0.0311" izz="0.0311"/>
  </link>

  <link name="wrist_1_link">
    <xacro:cyl r="0.042" l="0.10" xyz="0 0 0.105" mat="ur_light"/>
    <xacro:cyl r="0.043" l="0.010" xyz="0 0 0.16" mat="ur_cap"/>
    <xacro:inertial m="1.37" xyz="0 0 0.12" ixx="0.0026" iyy="0.0026" izz="0.0022"/>
  </link>

  <link name="wrist_2_link">
    <xacro:cyl r="0.042" l="0.096" xyz="0 0 0.078" mat="ur_light"/>
    <xacro:cyl r="0.043" l="0.010" xyz="0 0 0.03" mat="ur_cap"/>
    <xacro:inertial m="1.3" xyz="0 0 0.08" ixx="0.0026" iyy="0.0026" izz="0.0022"/>
  </link>

  <link name="wrist_3_link">
    <xacro:cyl r="0.042" l="0.07" xyz="0 0 0.045" mat="ur_light"/>
    <xacro:cyl r="0.032" l="0.010" xyz="0 0 ${d6 - 0.005}" mat="ur_dark"/>
    <xacro:inertial m="0.365" xyz="0 0 0.07" ixx="0.0002" iyy="0.0002" izz="0.0003"/>
  </link>

  <link name="tool0"/>

  <link name="ft_sensor_link">
    <xacro:cyl r="0.0375" l="${ft_thickness}" xyz="0 0 ${ft_thickness / 2}" mat="ft_grey"/>
    <xacro:cyl r="0.0385" l="0.008" xyz="0 0 ${ft_thickness * 0.3}" mat="ur_cap"/>
    <xacro:inertial m="0.3" xyz="0 0 ${ft_thickness / 2}" ixx="0.0002" iyy="0.0002" izz="0.0003"/>
  </link>

  <!-- measurement frame of the F/T sensor (tool side), wrench is published here -->
  <link name="ft_frame"/>

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 ${house_len / 2}"/>
      <geometry><box size="0.064 0.094 ${house_len}"/></geometry>
      <material name="gripper_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.012"/>
      <geometry><box size="0.066 0.040 0.008"/></geometry>
      <material name="ur_cap"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${house_len / 2}"/>
      <geometry><box size="0.064 0.094 ${house_len}"/></geometry>
    </collision>
    <xacro:inertial m="0.55" xyz="0 0 0.035" ixx="0.0012" iyy="0.0010" izz="0.0006"/>
  </link>

  <xacro:macro name="finger" params="side sgn">
    <link name="finger_${side}_link">
      <visual>
        <origin xyz="0 ${sgn * (pad_t * 2 + 0.005)} ${finger_len / 2}"/>
        <geometry><box size="${2 * pad_w} 0.010 ${finger_len}"/></geometry>
        <material name="gripper_black"/>
      </visual>
      <visual>
        <origin xyz="0 ${sgn * pad_t} ${finger_len}"/>
        <geometry><box size="${2 * pad_w} ${2 * pad_t} ${2 * pad_h}"/></geometry>
        <material name="pad_orange"/>
      </visual>
      <collision>
        <origin xyz="0 ${sgn * pad_t} ${finger_len}"/>
        <geometry><box size="${2 * pad_w} ${2 * pad_t} ${2 * pad_h}"/></geometry>
      </collision>
      <xacro:inertial m="0.05" xyz="0 ${sgn * 0.008} ${finger_len / 2}" ixx="2e-5" iyy="2e-5" izz="5e-6"/>
    </link>
  </xacro:macro>
  <xacro:finger side="left" sgn="1"/>
  <xacro:finger side="right" sgn="-1"/>

  <!-- tool centre point: between the finger pads -->
  <link name="tcp"/>

  <!-- ===================== joints -->
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_link-base_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
  </joint>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2 * pi}" upper="${2 * pi}" effort="150" velocity="3.14"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 ${d1}" rpy="${pi / 2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2 * pi}" upper="${2 * pi}" effort="150" velocity="3.14"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="${a2} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="150" velocity="3.14"/>
  </joint>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="${a3} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2 * pi}" upper="${2 * pi}" effort="28" velocity="3.14"/>
  </joint>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0 ${d4}" rpy="${pi / 2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2 * pi}" upper="${2 * pi}" effort="28" velocity="3.14"/>
  </joint>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 ${d5}" rpy="${-pi / 2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2 * pi}" upper="${2 * pi}" effort="28" velocity="3.14"/>
  </joint>

  <joint name="wrist_3-tool0_fixed_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${d6}" rpy="0 0 0"/>
  </joint>

  <joint name="tool0-ft_sensor_fixed_joint" type="fixed">
    <parent link="tool0"/>
    <child link="ft_sensor_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="ft_sensor-ft_frame_fixed_joint" type="fixed">
    <parent link="ft_sensor_link"/>
    <child link="ft_frame"/>
    <origin xyz="0 0 ${ft_thickness}" rpy="0 0 0"/>
  </joint>

  <joint name="ft_frame-gripper_fixed_joint" type="fixed">
    <parent link="ft_frame"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="finger_left_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="finger_left_link"/>
    <origin xyz="0 0 ${house_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="${finger_stroke}" effort="30" velocity="0.075"/>
  </joint>

  <joint name="finger_right_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="finger_right_link"/>
    <origin xyz="0 0 ${house_len}" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="${finger_stroke}" effort="30" velocity="0.075"/>
    <mimic joint="finger_left_joint" multiplier="1" offset="0"/>
  </joint>

  <joint name="gripper-tcp_fixed_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tcp"/>
    <origin xyz="0 0 ${tcp_g}" rpy="0 0 0"/>
  </joint>
</robot>
