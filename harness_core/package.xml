<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>harness_core</name>
  <version>0.1.0</version>
  <description>ROS-independent core of the wire-harness cell: MuJoCo scene generator, UR5e kinematics, Cartesian compliance controller and the force-guided routing expert.</description>
  <maintainer email="rezahendi590@gmail.com">Reza</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- also needs pip packages (not rosdep keys): mujoco -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
